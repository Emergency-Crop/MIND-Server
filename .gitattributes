# 모든 텍스트 파일은 기본적으로 LF로 처리
* text=auto eol=lf

# 스크립트 파일 - OS에 맞게 줄바꿈 명시
*.sh text eol=lf
*.bat text eol=crlf

# 설정/환경 파일 - Linux 컨테이너용
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.env text eol=lf

# 소스코드
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.cpp text eol=lf
*.h text eol=lf

# 바이너리 파일은 줄바꿈 처리 금지
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
